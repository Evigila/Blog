---
import { isNavigationCurrent, normalizePath, siteConfig, siteNavigation } from '../data/site';

const githubLink = siteConfig.socials.find((item) => item.icon === 'github')?.href ?? '#';
const pathname = normalizePath(Astro.url.pathname);
const navigation = siteNavigation.map((item) => ({
	...item,
	href: item.key === 'about' && pathname === '/' ? '#about' : item.href,
}));
---

<nav class="editorial-global-nav" aria-label="站点导航">
	<a class="editorial-global-nav__brand" href="/">EVIGILA的博客</a>
	<div data-editorial-nav-items>
		<span class="editorial-global-nav__indicator" data-editorial-nav-indicator aria-hidden="true"></span>
		{navigation.map((item) => (
			<a data-nav-key={item.key} data-nav-section={item.section} href={item.href} aria-current={isNavigationCurrent(item.section, pathname) ? 'page' : undefined}>{item.label}</a>
		))}
		<a data-nav-key="github" href={githubLink} target="_blank" rel="noreferrer" aria-label="GITHUB（在新标签页打开）">GITHUB</a>
	</div>
</nav>

<style>
	.editorial-global-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.06em;
	}

	.editorial-global-nav__brand {
		color: var(--editorial-ink);
		letter-spacing: 0;
		white-space: nowrap;
	}

	.editorial-global-nav > div {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: clamp(0.35rem, 0.75vw, 0.7rem);
		background: var(--editorial-sheet);
		color: var(--editorial-ink);
	}

	.editorial-global-nav__indicator {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 0;
		width: var(--nav-indicator-width, 0);
		height: 2.5rem;
		border: 1px solid var(--editorial-charcoal);
		border-radius: var(--control-radius);
		background: var(--editorial-charcoal);
		opacity: 0;
		transform: translate3d(var(--nav-indicator-x, 0), var(--nav-indicator-y, 0), 0);
		pointer-events: none;
		view-transition-name: editorial-nav-indicator;
		will-change: width, transform;
		transition:
			width 220ms cubic-bezier(0.2, 0.78, 0.2, 1),
			transform 220ms cubic-bezier(0.2, 0.78, 0.2, 1),
			opacity 120ms ease;
	}

	.editorial-global-nav__indicator[data-ready='true'] {
		opacity: 1;
	}

	.editorial-global-nav__indicator[data-snap='true'] {
		transition: none;
	}

	.editorial-global-nav > div a {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		height: 2.5rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid transparent;
		border-radius: var(--control-radius);
		background: transparent;
		color: var(--editorial-ink);
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	.editorial-global-nav > div a:hover,
	.editorial-global-nav > div a:focus-visible {
		border-color: var(--editorial-line);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.58);
	}

	.editorial-global-nav > div a[data-indicator-current='true'] {
		border-color: transparent;
		color: #fff;
		box-shadow: none;
	}

	.editorial-global-nav > div a[data-indicator-current='true']:hover,
	.editorial-global-nav > div a[data-indicator-current='true']:focus-visible {
		border-color: transparent;
		box-shadow: none;
	}

	@supports (mix-blend-mode: difference) {
		.editorial-global-nav > div a {
			color: #fff;
			mix-blend-mode: difference;
		}

		.editorial-global-nav > div a[data-indicator-current='true'] {
			color: #fff;
			mix-blend-mode: normal;
		}
	}

	@media (max-width: 760px) {
		.editorial-global-nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.2rem;
		}

		.editorial-global-nav > div {
			justify-content: flex-start;
			gap: 0.75rem 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.editorial-global-nav__indicator,
		.editorial-global-nav > div a {
			transition: none;
		}

		.editorial-global-nav__indicator {
			transform: translate3d(var(--nav-indicator-x, 0), var(--nav-indicator-y, 0), 0);
		}
	}

	@media (forced-colors: active) {
		.editorial-global-nav__indicator {
			background: Highlight;
			forced-color-adjust: none;
		}

		.editorial-global-nav > div a {
			color: LinkText;
			mix-blend-mode: normal;
		}

		.editorial-global-nav > div a[data-indicator-current='true'] {
			color: HighlightText;
			forced-color-adjust: none;
		}
	}
</style>

<script>
	const initializeEditorialNavigation = () => {
		document.querySelectorAll<HTMLElement>('[data-editorial-nav-items]').forEach((items) => {
			if (items.dataset.navigationInitialized === 'true') return;
			items.dataset.navigationInitialized = 'true';

			const indicator = items.querySelector<HTMLElement>('[data-editorial-nav-indicator]');
			const links = [...items.querySelectorAll<HTMLAnchorElement>('a[data-nav-key]')];
			if (!indicator || links.length === 0) return;

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			const supportsCrossDocumentViewTransitions = CSS.supports('view-transition-name: editorial-nav-indicator') && 'onpagereveal' in window;
			let selectedLink: HTMLAnchorElement | undefined;
			let layoutFrame: number | undefined;
			let indicatorGeometry: { x: number; y: number; width: number } | undefined;
			const transitionStorageKey = 'editorial-navigation-transition';
			const normalizedLocation = (url: URL) => {
				const path = url.pathname === '/' ? '/' : url.pathname.replace(/\/+$/, '');
				return `${path}${url.search}${url.hash}`;
			};

			const visualCurrentLink = () => {
				const currentPath = window.location.pathname === '/' ? '/' : window.location.pathname.replace(/\/+$/, '');
				const current = window.location.hash === '#about'
					? links.find((link) => link.dataset.navKey === 'about')
					: links.find((link) => {
						const section = link.dataset.navSection;
						if (!section) return false;
						return section === '/'
							? currentPath === '/'
							: currentPath === section || currentPath.startsWith(`${section}/`);
					});
				const currentKey = current?.dataset.navKey;
				links.forEach((link) => link.removeAttribute('aria-current'));
				if (current) current.setAttribute('aria-current', currentKey === 'about' ? 'location' : 'page');
				return current;
			};

			const moveIndicator = (link: HTMLAnchorElement | undefined, animate = true) => {
				if (!link) {
					indicator.removeAttribute('data-ready');
					return;
				}
				const itemsRect = items.getBoundingClientRect();
				const linkRect = link.getBoundingClientRect();
				const nextGeometry = {
					x: linkRect.left - itemsRect.left,
					y: linkRect.top - itemsRect.top,
					width: linkRect.width,
				};
				const geometryChanged = !indicatorGeometry
					|| Math.abs(indicatorGeometry.x - nextGeometry.x) > 0.01
					|| Math.abs(indicatorGeometry.y - nextGeometry.y) > 0.01
					|| Math.abs(indicatorGeometry.width - nextGeometry.width) > 0.01;

				if (selectedLink !== link) {
					selectedLink = link;
					links.forEach((item) => {
						if (item === link) item.dataset.indicatorCurrent = 'true';
						else item.removeAttribute('data-indicator-current');
					});
				}
				if (geometryChanged) {
					if (!animate || reducedMotion.matches) indicator.dataset.snap = 'true';
					indicator.style.setProperty('--nav-indicator-x', `${nextGeometry.x}px`);
					indicator.style.setProperty('--nav-indicator-y', `${nextGeometry.y}px`);
					indicator.style.setProperty('--nav-indicator-width', `${nextGeometry.width}px`);
					indicatorGeometry = nextGeometry;
				}
				indicator.dataset.ready = 'true';
				if (geometryChanged && (!animate || reducedMotion.matches)) {
					requestAnimationFrame(() => indicator.removeAttribute('data-snap'));
				}
			};
			const scheduleLayoutSync = () => {
				if (layoutFrame !== undefined) return;
				layoutFrame = requestAnimationFrame(() => {
					layoutFrame = undefined;
					moveIndicator(selectedLink ?? visualCurrentLink(), false);
				});
			};

			const currentTarget = visualCurrentLink();
			let transitionFrom: HTMLAnchorElement | undefined;
			if (!reducedMotion.matches && !supportsCrossDocumentViewTransitions) {
				try {
					const stored = window.sessionStorage.getItem(transitionStorageKey);
					window.sessionStorage.removeItem(transitionStorageKey);
					if (stored) {
						const transition = JSON.parse(stored) as { fromKey?: string; toKey?: string; target?: string; timestamp?: number };
						const currentLocation = normalizedLocation(new URL(window.location.href));
						if (
							transition.target === currentLocation &&
							transition.toKey === currentTarget?.dataset.navKey &&
							typeof transition.timestamp === 'number' &&
							Date.now() - transition.timestamp < 2000
						) {
							transitionFrom = links.find((link) => link.dataset.navKey === transition.fromKey);
						}
					}
				} catch {
					// Navigation remains fully functional when session storage is unavailable.
				}
			}

			if (supportsCrossDocumentViewTransitions) {
				try {
					window.sessionStorage.removeItem(transitionStorageKey);
				} catch {
					// Navigation does not depend on storage.
				}
				moveIndicator(currentTarget, false);
			} else requestAnimationFrame(() => {
				if (transitionFrom && transitionFrom !== currentTarget) {
					moveIndicator(transitionFrom, false);
					requestAnimationFrame(() => requestAnimationFrame(() => moveIndicator(currentTarget)));
				} else {
					moveIndicator(currentTarget, false);
				}
			});

			links.forEach((link) => {
				link.addEventListener('click', (event) => {
					if (
						event.defaultPrevented ||
						event.button !== 0 ||
						event.metaKey ||
						event.ctrlKey ||
						event.shiftKey ||
						event.altKey ||
						link.target === '_blank'
					) return;

					const destination = new URL(link.href, window.location.href);
					if (destination.origin !== window.location.origin || destination.href === window.location.href) return;
					if (destination.pathname === window.location.pathname && destination.search === window.location.search) {
						if (destination.hash === '#about') {
							const about = document.querySelector<HTMLElement>('#about');
							if (about) {
								event.preventDefault();
								const rootStyle = document.documentElement.style;
								const previousBehavior = rootStyle.getPropertyValue('scroll-behavior');
								const previousPriority = rootStyle.getPropertyPriority('scroll-behavior');
								rootStyle.setProperty('scroll-behavior', 'auto', 'important');
								window.history.pushState(null, '', destination);
								about.scrollIntoView({ block: 'start', behavior: 'auto' });
								moveIndicator(visualCurrentLink(), !reducedMotion.matches);
								requestAnimationFrame(() => {
									if (previousBehavior) rootStyle.setProperty('scroll-behavior', previousBehavior, previousPriority);
									else rootStyle.removeProperty('scroll-behavior');
								});
								return;
							}
						}
						moveIndicator(link, !reducedMotion.matches);
						return;
					}

					if (!reducedMotion.matches && !supportsCrossDocumentViewTransitions) {
						try {
							window.sessionStorage.setItem(transitionStorageKey, JSON.stringify({
								fromKey: (selectedLink ?? visualCurrentLink())?.dataset.navKey,
								toKey: link.dataset.navKey,
								target: normalizedLocation(destination),
								timestamp: Date.now(),
							}));
						} catch {
							// The link keeps its native navigation behavior without the enhancement.
						}
					}
				});
			});

			window.addEventListener('resize', scheduleLayoutSync, { passive: true });
			window.addEventListener('hashchange', () => moveIndicator(visualCurrentLink()));
			window.addEventListener('pageshow', scheduleLayoutSync);
			const itemObserver = new ResizeObserver(scheduleLayoutSync);
			itemObserver.observe(items);
			document.fonts?.ready.then(scheduleLayoutSync);
		});
	};

	initializeEditorialNavigation();
</script>
