---
import WorkspaceShell from './WorkspaceShell.astro';
import SiteFooter from './SiteFooter.astro';
import '../styles/editorial-frame.css';

interface Props {
	class?: string;
	home?: boolean;
}

const { class: className, home = false } = Astro.props;
---

<WorkspaceShell class={className}>
	<div class="editorial-frame" data-editorial-home={home ? '' : undefined}>
		<header class="editorial-frame__header">
			<slot name="header" />
		</header>

		<slot />

		<SiteFooter />
	</div>
</WorkspaceShell>
