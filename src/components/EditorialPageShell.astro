---
import EditorialFrame from './EditorialFrame.astro';
import '../styles/editorial-pages.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<EditorialFrame class="editorial-page">
	<div slot="header" class="editorial-frame__intro editorial-page__intro">
		<div class="editorial-frame__intro-main">
			<h1 class="editorial-frame__title">{title}</h1>
		</div>
	</div>

	<slot />
</EditorialFrame>
