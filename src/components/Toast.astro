---

<div class="site-toast" id="site-toast" role="status" aria-live="polite" aria-atomic="true">
	<div class="site-toast__body">
		<span id="site-toast-text"></span>
	</div>
</div>

<style>
	.site-toast {
		position: fixed;
		left: 50%;
		bottom: 2.5rem;
		transform: translateX(-50%) translateY(0.9rem);
		z-index: 200;
		opacity: 0;
		pointer-events: none;
		border: 1px solid var(--workspace-line-strong);
		border-radius: var(--workspace-radius-small);
		background: var(--workspace-surface);
		box-shadow: 0 8px 24px rgb(21 58 50 / 18%);
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.site-toast.is-visible {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}

	.site-toast__body {
		padding: 0.72rem 1.15rem;
		font-family: var(--font-ui);
		font-size: 17px;
		font-weight: var(--weight-medium);
		color: var(--workspace-ink);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-toast { transition: none; }
	}
</style>

<script>
	const _toastEl = document.getElementById('site-toast') as HTMLElement;
	const _toastTextEl = document.getElementById('site-toast-text') as HTMLElement;
	let _toastTimer: ReturnType<typeof setTimeout> | null = null;

	function showToast(message: string, duration = 3000): void {
		_toastTextEl.textContent = message;
		_toastEl.classList.add('is-visible');

		if (_toastTimer !== null) clearTimeout(_toastTimer);
		_toastTimer = setTimeout(() => {
			_toastEl.classList.remove('is-visible');
			_toastTimer = null;
		}, duration);
	}

	function hideToast(): void {
		if (_toastTimer !== null) clearTimeout(_toastTimer);
		_toastTimer = null;
		_toastEl.classList.remove('is-visible');
		_toastTextEl.textContent = '';
	}

	(window as unknown as { showToast: typeof showToast }).showToast = showToast;
	window.addEventListener('pagehide', hideToast);
	window.addEventListener('pageshow', hideToast);
</script>
