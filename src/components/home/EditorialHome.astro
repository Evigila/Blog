---
import { siteConfig } from '../../data/site';
import { getTagHref, type EditorialPostSummary } from '../../data/blog';
import EditorialFrame from '../EditorialFrame.astro';
import '../../styles/home-editorial.css';
import '../../styles/post-collection.css';

interface Props {
	posts: EditorialPostSummary[];
}

const { posts } = Astro.props;
const githubLink = siteConfig.socials.find((item) => item.icon === 'github')?.href ?? '#';
const mailLink = siteConfig.socials.find((item) => item.icon === 'mail')?.href ?? '#';
---

<EditorialFrame class="editorial-home" home>
	<div slot="header" class="editorial-frame__intro editorial-home__intro">
		<div class="editorial-frame__intro-main">
			<h1 class="editorial-frame__title">
				<span data-greeting-line="first">欢迎，早上好。</span>
				<span data-greeting-line="second">祝你有美好的一天</span>
			</h1>
		</div>
	</div>

	<section class="workspace-page-module" aria-labelledby="latest-title">
		<div class="workspace-section-heading">
			<h2 id="latest-title">近期发布</h2>
			<a class="workspace-secondary-action" href="/articles">浏览所有</a>
		</div>

		<div class="workspace-post-list" data-post-collection>
			{posts.length > 0 ? posts.slice(0, 6).map((post, index) => {
				const menuId = `home-post-menu-${index}`;
				const menuTriggerId = `${menuId}-trigger`;
				return (
				<article class="workspace-post-row" data-post-row data-post-href={post.href}>
					<div class="workspace-post-row__media" aria-hidden="true">
						{post.image ? <img src={post.image} alt="" width="240" height="150" loading="lazy" decoding="async" /> : <span>EVG</span>}
					</div>
					<div class="workspace-post-row__body">
						<h3>{post.title}</h3>
						<p>{post.excerpt}</p>
						<div class="workspace-post-row__tags">{post.tags.slice(0, 3).map((tag) => <a href={getTagHref(tag)}>#{tag}</a>)}</div>
					</div>
					<div class="workspace-row-menu" data-row-menu>
						<button class="workspace-row-menu__trigger" id={menuTriggerId} type="button" aria-label={`${post.title}的操作`} aria-haspopup="menu" aria-expanded="false" aria-controls={menuId} data-row-menu-trigger>···</button>
						<div class="workspace-row-menu__popup" id={menuId} role="menu" aria-labelledby={menuTriggerId} hidden data-row-menu-popup>
							<a href={post.href} role="menuitem">阅读文章</a>
							<a href={post.href} target="_blank" rel="noreferrer" role="menuitem">在新标签页打开</a>
						</div>
					</div>
				</article>
			)}) : <p class="workspace-empty-state">暂无已发布文章。</p>}
		</div>
	</section>

	<section class="workspace-page-module editorial-author" id="about" aria-labelledby="author-title">
		<div class="workspace-section-heading">
			<h2 id="author-title">关于</h2>
		</div>
		<div class="editorial-author__content">
			<img src={siteConfig.author.avatar} alt="Evigila 的头像" width="160" height="160" loading="lazy" decoding="async" />
			<div>
				<h3>{siteConfig.author.bio}</h3>
				<div class="editorial-author__actions">
					<a class="workspace-secondary-action" href={githubLink} target="_blank" rel="noreferrer">GitHub</a>
					<a class="workspace-secondary-action" href={mailLink}>邮件联系</a>
					<a class="workspace-secondary-action" href="/about">查看更多</a>
				</div>
			</div>
		</div>
	</section>
</EditorialFrame>

<script>
	import { initEditorialHome } from '../../scripts/editorial-home';
	initEditorialHome();
</script>
