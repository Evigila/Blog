---
import SiteLayout from './SiteLayout.astro';
import Toast from '../components/Toast.astro';
import WorkspaceShell from '../components/WorkspaceShell.astro';
import WorkspaceIcon from '../components/WorkspaceIcon.astro';
import { siteConfig } from '../data/site';
import { getTagHref } from '../data/blog';
import '../styles/post.css';

interface TocHeading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	excerpt: string;
	publishDate: Date;
	updatedAt: Date;
	readingTime: string;
	wordCount: number;
	tags: string[];
	headings: TocHeading[];
	heroImage?: string;
}

const { title, excerpt, publishDate, updatedAt, readingTime, wordCount, tags, headings, heroImage } = Astro.props;
const publishedLabel = publishDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const updatedLabel = updatedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const publishedISO = publishDate.toISOString().slice(0, 10);
const updatedISO = updatedAt.toISOString().slice(0, 10);
const readingMinutes = Math.max(1, Number.parseInt(readingTime, 10) || 1);
---

<SiteLayout title={`${title} - Evigila 的博客`} description={excerpt}>
	<WorkspaceShell>
		<div class="post-page" data-post-reader>
			<header class="post-heading">
				<div>
					<a class="post-parent-link" href="/articles">← 全部文章</a>
					<h1>{title}</h1>
					<p>{excerpt}</p>
					<div class="post-meta" aria-label="文章信息">
						<time datetime={publishedISO}>发布 {publishedLabel}</time>
						<time datetime={updatedISO}>更新 {updatedLabel}</time>
						<time datetime={`PT${readingMinutes}M`}>{readingTime}</time>
						<data value={wordCount}>{wordCount.toLocaleString('zh-CN')} 字词</data>
					</div>
				</div>
			</header>

			<div class="post-page__layout">
				<article class="post-article" data-post-article>
					{heroImage && (
						<figure class="post-cover" data-cover-media data-cover-state="ready" aria-busy="false">
							<img src={heroImage} alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
						</figure>
					)}

					<div class="post-content" data-post-content>
						<slot />
					</div>

					<section class="post-comments" id="post-comments" aria-labelledby="post-comments-title">
						<h2 id="post-comments-title">评论区</h2>
						<div
							class="post-comments__widget"
							data-giscus-root
							data-giscus-repo="Evigila/Blog"
							data-giscus-repo-id="R_kgDOSTv6rQ"
							data-giscus-category="Announcements"
							data-giscus-category-id="DIC_kwDOSTv6rc4C8n35"
							data-giscus-mapping="pathname"
							data-giscus-strict="0"
							data-giscus-reactions-enabled="1"
							data-giscus-emit-metadata="0"
							data-giscus-input-position="bottom"
							data-giscus-theme="light"
							data-giscus-lang="zh-CN"
						>
							<noscript><p>评论需要启用 JavaScript。你也可以前往 <a href="https://github.com/Evigila/Blog/discussions">GitHub Discussions</a> 查看讨论。</p></noscript>
						</div>
					</section>
				</article>

				<aside class="post-inspector" aria-label="文章目录与操作">
					<div class="post-inspector__scroll">
						<section class="post-outline" data-post-outline style="--reading-progress: 0%;" aria-labelledby="post-contents-title">
							<div class="post-outline__heading">
								<strong id="post-contents-title">文章目录</strong>
								<span data-reading-progress-value>0%</span>
							</div>
							<div class="post-outline__bar" aria-hidden="true"><span></span></div>
							{headings.length > 0 ? (
								<ol class="post-outline__list">
									{headings.map((heading) => (
										<li class={`post-outline__item post-outline__item--depth-${Math.min(Math.max(heading.depth, 2), 6)}`}>
											<a href={`#${heading.slug}`} data-toc-link data-target-id={heading.slug}>{heading.text}</a>
										</li>
									))}
								</ol>
							) : <p class="post-outline__empty">本文没有章节标题。</p>}
						</section>

						<section class="post-tag-panel" aria-labelledby="post-tags-title">
							<strong id="post-tags-title">标签</strong>
							<div>{tags.map((tag) => <a href={getTagHref(tag)}>#{tag}</a>)}</div>
						</section>

						<section class="post-author" aria-labelledby="post-author-title">
							<strong id="post-author-title">作者</strong>
							<div><img src={siteConfig.author.avatar} alt="" width="56" height="56" /><span><b>{siteConfig.author.name}</b>{siteConfig.author.signature}</span></div>
						</section>
					</div>

					<div class="post-inspector__actions">
						<button type="button" data-scroll-top><WorkspaceIcon name="arrow-up" size={19} />返回顶部</button>
						<button type="button" data-share><WorkspaceIcon name="share" size={19} />分享文章</button>
						<a href="#post-comments" data-scroll-comments><WorkspaceIcon name="comments" size={19} />评论区</a>
					</div>
				</aside>
			</div>

			<footer class="post-footer"><span>© {new Date().getFullYear()} EVIGILA</span><a href="/articles">返回全部文章</a></footer>
		</div>
	</WorkspaceShell>
	<Toast />

	<script>
		import { initPostPage } from '../scripts/post';
		initPostPage();
	</script>
</SiteLayout>
