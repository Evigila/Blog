---
import EditorialPageShell from '../components/EditorialPageShell.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
	documentTitle: string;
	title: string;
	metaDescription?: string;
}

const { documentTitle, title, metaDescription } = Astro.props;
---

<SiteLayout title={documentTitle} description={metaDescription}>
	<EditorialPageShell title={title}>
		<slot />
	</EditorialPageShell>
</SiteLayout>
