---
import EditorialTagDirectory from '../../components/EditorialTagDirectory.astro';
import { getBlogDirectory } from '../../data/blog';
import EditorialPageLayout from '../../layouts/EditorialPageLayout.astro';

export async function getStaticPaths() {
	const { tags } = await getBlogDirectory();
	return tags.map((tag) => ({ params: { tag: tag.slug } }));
}

const { posts, tags } = await getBlogDirectory();
const activeSlug = Astro.params.tag ?? '';
const activeTag = tags.find((tag) => tag.slug === activeSlug)!;
---

<EditorialPageLayout documentTitle={`#${activeTag.name} | Evigila`} title="内容标签" eyebrow="FILTER" description="通过标签筛选和整理文章" metaDescription={`浏览带有 ${activeTag.name} 标签的博客文章。`}>
		<EditorialTagDirectory posts={posts} tags={tags} activeSlug={activeSlug} />
</EditorialPageLayout>
