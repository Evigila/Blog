---
import EditorialPostIndex from '../components/EditorialPostIndex.astro';
import { getBlogDirectory } from '../data/blog';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';

const { posts } = await getBlogDirectory();
---

<EditorialPageLayout documentTitle="全部文章 - Evigila 的博客" title="全部文章" metaDescription="Evigila 发布的技术文章列表。">
		<section class="editorial-page__section">
			<EditorialPostIndex posts={posts} layout="grid" />
		</section>
</EditorialPageLayout>
