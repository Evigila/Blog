---
import EditorialHome from '../components/home/EditorialHome.astro';
import { getBlogDirectory } from '../data/blog';
import { siteConfig } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';

const { posts } = await getBlogDirectory();
---

<SiteLayout title={siteConfig.title} description={siteConfig.description}>
	<EditorialHome posts={posts} archiveCount={posts.length} />
</SiteLayout>
